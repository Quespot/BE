# Spring Boot는 이 파일을 자동으로 읽지 않습니다.
# 각자 로컬 환경이나 IDE 실행 설정에 맞게 값을 등록해서 사용합니다.
# 운영 EC2에서는 /opt/quespot/.env로 복사한 뒤 실제 값을 입력하고 권한을 600으로 제한합니다.

DB_URL=
DB_USERNAME=quespot
DB_PASSWORD=
DB_POOL_MAX_SIZE=5

JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
JPA_USE_SQL_COMMENTS=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=14
# HTTPS 운영 배포에서는 true를 사용하고, 로컬 또는 임시 HTTP 개발 환경에서만 false로 변경합니다.
JWT_REFRESH_TOKEN_COOKIE_SECURE=true
JWT_REFRESH_TOKEN_COOKIE_SAME_SITE=Lax

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
DEFAULT_PROFILE_IMAGE_URL=https://example.com/images/default-profile.png

GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/login/oauth2/code/google
OAUTH2_FRONTEND_REDIRECT_URI=http://localhost:5173/oauth/callback
OAUTH2_LOGIN_CODE_EXPIRATION_SECONDS=60

# Firebase 서비스 계정 키(JSON)의 실행 환경 내 경로입니다. 비워두면 Firebase 기능 없이 기동합니다.
FIREBASE_CREDENTIALS_PATH=

MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_VERIFICATION_CODE_EXPIRATION_MINUTES=10
MAIL_VERIFICATION_CODE_REQUEST_WINDOW_MINUTES=10
MAIL_VERIFICATION_CODE_REQUEST_LIMIT=5
MAIL_VERIFICATION_CODE_CLIENT_REQUEST_LIMIT=20
MAIL_VERIFICATION_CODE_FAILED_ATTEMPT_LIMIT=5
MAIL_VERIFICATION_COMPLETION_EXPIRATION_MINUTES=30
MAIL_VERIFICATION_CODE_SECRET=

# 로컬에서는 true, 운영 EC2에서는 false를 사용합니다.
SWAGGER_ENABLED=true
SWAGGER_LOCAL_SERVER_URL=http://localhost:8080
SWAGGER_PRODUCTION_SERVER_URL=http://52.78.110.222
