# Spring Boot는 이 파일을 자동으로 읽지 않습니다.
# 각자 로컬 환경이나 IDE 실행 설정에 맞게 값을 등록해서 사용합니다.
# 운영 EC2에서는 실제 값을 입력하고 권한을 600으로 제한합니다.

DB_URL=
DB_USERNAME=quespot_app
DB_PASSWORD=
DB_POOL_MAX_SIZE=5

AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
S3_PRESIGNED_URL_EXPIRATION_SECONDS=300
S3_MAX_FILE_SIZE_BYTES=10485760

JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
JPA_USE_SQL_COMMENTS=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=14
# 로컬 HTTP에서는 false를 사용하고, HTTPS 운영 배포에서는 true로 변경합니다.
JWT_REFRESH_TOKEN_COOKIE_SECURE=false
JWT_REFRESH_TOKEN_COOKIE_SAME_SITE=Lax

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,https://quespot.site,https://www.quespot.site
DEFAULT_PROFILE_IMAGE_URL=https://example.com/images/default-profile.png

GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/login/oauth2/code/google

KAKAO_OAUTH_ENABLED=false
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_ADMIN_KEY=
KAKAO_OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/login/oauth2/code/kakao

NAVER_OAUTH_ENABLED=false
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/login/oauth2/code/naver

OAUTH2_FRONTEND_REDIRECT_URI=http://localhost:5173/oauth/callback
OAUTH2_ALLOWED_FRONTEND_REDIRECT_URIS=http://localhost:5173/oauth/callback,https://quespot.site/oauth/callback
OAUTH2_LOGIN_CODE_EXPIRATION_SECONDS=60
OAUTH2_LINK_REQUEST_EXPIRATION_SECONDS=120
OAUTH2_UNLINK_RETRY_DELAY_MS=30000
# `openssl rand -base64 32`로 생성하며 운영 중 변경하면 저장된 OAuth 토큰을 복호화할 수 없습니다.
OAUTH2_TOKEN_ENCRYPTION_KEY=

# Firebase 서비스 계정 키(JSON)의 실행 환경 내 경로입니다. 비워두면 Firebase 기능 없이 기동합니다.
FIREBASE_CREDENTIALS_PATH=

# 주변 미션 추천 푸시 스케줄러. 운영에서만 true. cron은 Asia/Seoul 기준.
NOTIFICATION_RECOMMENDATION_ENABLED=false
NOTIFICATION_RECOMMENDATION_CRON=0 0 11 * * *
NOTIFICATION_RECOMMENDATION_RADIUS_METERS=3000
NOTIFICATION_RECOMMENDATION_LOCATION_MAX_AGE_DAYS=7

MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_VERIFICATION_CODE_EXPIRATION_MINUTES=10
MAIL_VERIFICATION_CODE_REQUEST_WINDOW_MINUTES=10
MAIL_VERIFICATION_CODE_REQUEST_LIMIT=5
MAIL_VERIFICATION_CODE_CLIENT_REQUEST_LIMIT=20
MAIL_VERIFICATION_CODE_FAILED_ATTEMPT_LIMIT=5
MAIL_VERIFICATION_COMPLETION_EXPIRATION_MINUTES=30
MAIL_VERIFICATION_CODE_SECRET=

# 로컬에서는 true, 운영 EC2에서는 false를 사용합니다.
SWAGGER_ENABLED=true
SWAGGER_LOCAL_SERVER_URL=http://localhost:8080
SWAGGER_PRODUCTION_SERVER_URL=https://api.quespot.site

# TourAPI(KorService2) 서비스키. 일 1,000건 제한이며 로컬 호출도 차감됩니다.
TOUR_API_SERVICE_KEY=
TOUR_API_DAILY_LIMIT=1000
# 로컬에서 실수로 켜면 쿼터가 낭비되니 기본 false 유지.
TOUR_API_SCHEDULER_ENABLED=false
TOUR_API_SCHEDULER_CRON=0 0 4 * * *
